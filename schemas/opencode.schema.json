{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode Configuration Schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "skills": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["paths"],
      "additionalProperties": false
    }
  },
  "required": ["$schema", "skills"],
  "additionalProperties": false
}
